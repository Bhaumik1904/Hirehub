<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
  register.fxml — HireHub Split-Screen Registration View
  Redesigned to match approved Figma Make specification
  Controller: com.hirehub.controller.RegisterController
  Preserves 100% of existing fx:id bindings, event handlers, and background Task registration.
-->
<BorderPane xmlns="http://javafx.oracle.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.hirehub.controller.RegisterController"
            styleClass="auth-split-root"
            prefWidth="1200" prefHeight="750">

    <!-- ── Left Hero Pane (Dark Navy #0F172A) ── -->
    <left>
        <VBox styleClass="auth-hero-pane" prefWidth="540" minWidth="480" maxWidth="600" spacing="36">

            <!-- Brand Logo -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane styleClass="sidebar-logo-badge">
                    <Label text="H" style="-fx-font-weight: bold; -fx-text-fill: #2563EB; -fx-font-size: 18px;"/>
                </StackPane>
                <VBox spacing="1">
                    <Label text="HireHub" styleClass="sidebar-brand-name" style="-fx-font-size: 20px;"/>
                    <Label text="Campus careers, connected." styleClass="sidebar-brand-sub" style="-fx-text-fill: #64748B;"/>
                </VBox>
            </HBox>

            <Pane VBox.vgrow="ALWAYS"/>

            <!-- Central Hero Graphic / Typography Card -->
            <VBox spacing="18" maxWidth="460">
                <Label text="ONBOARDING WORKSPACE"
                       style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #38BDF8; -fx-letter-spacing: 1px;"/>
                <Label text="Join the trusted campus recruitment network."
                       styleClass="auth-hero-title"/>
                <Label text="Register your student profile or verified recruiter account to access intelligent matching, ATS screening, and live placement drives."
                       styleClass="auth-hero-sub"/>
            </VBox>

            <Pane VBox.vgrow="ALWAYS"/>

            <!-- ── Bottom Product Capability Highlights ── -->
            <HBox styleClass="auth-stats-row" spacing="16">
                <VBox styleClass="auth-stat-card" HBox.hgrow="ALWAYS">
                    <Label text="Campus First" styleClass="auth-stat-val" style="-fx-font-size: 14.5px;"/>
                    <Label text="Structured cohorts" styleClass="auth-stat-lbl"/>
                </VBox>
                <VBox styleClass="auth-stat-card" HBox.hgrow="ALWAYS">
                    <Label text="Verified" styleClass="auth-stat-val" style="-fx-font-size: 14.5px;"/>
                    <Label text="Moderated partners" styleClass="auth-stat-lbl"/>
                </VBox>
                <VBox styleClass="auth-stat-card" HBox.hgrow="ALWAYS">
                    <Label text="AI Powered" styleClass="auth-stat-val" style="-fx-font-size: 14.5px; -fx-text-fill: #38BDF8;"/>
                    <Label text="ATS resume insights" styleClass="auth-stat-lbl"/>
                </VBox>
            </HBox>

        </VBox>
    </left>

    <!-- ── Right Form Pane ── -->
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="scroll-transparent">
            <VBox alignment="CENTER" style="-fx-background-color: #FFFFFF; -fx-padding: 36 48;">

                <VBox alignment="TOP_LEFT" maxWidth="440" minWidth="360" spacing="16">

                    <Label text="GET STARTED WITH HIREHUB"
                           style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #2563EB; -fx-letter-spacing: 0.8px;"/>

                    <VBox spacing="4">
                        <Label text="Create your account"
                               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #0F172A; -fx-font-family: 'Segoe UI Semibold', 'Segoe UI', sans-serif;"/>
                        <Label text="Enter your details to create an account on HireHub."
                               style="-fx-font-size: 13px; -fx-text-fill: #64748B;"/>
                    </VBox>

                    <!-- ── Form Fields ── -->
                    <VBox spacing="12">

                        <!-- Full Name -->
                        <VBox spacing="5">
                            <Label text="Full Name" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #334155;"/>
                            <TextField fx:id="fullNameField" promptText="e.g. John Doe" styleClass="auth-field-input"/>
                        </VBox>

                        <!-- Email -->
                        <VBox spacing="5">
                            <Label text="Email Address" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #334155;"/>
                            <TextField fx:id="emailField" promptText="name@university.edu or company.com" styleClass="auth-field-input"/>
                        </VBox>

                        <!-- Password -->
                        <VBox spacing="5">
                            <Label text="Password" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #334155;"/>
                            <PasswordField fx:id="passwordField" promptText="Min. 8 chars, 1 upper, 1 digit" styleClass="auth-field-input"/>
                        </VBox>

                        <!-- Confirm Password -->
                        <VBox spacing="5">
                            <Label text="Confirm Password" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #334155;"/>
                            <PasswordField fx:id="confirmPasswordField" promptText="Re-enter your password" styleClass="auth-field-input"/>
                        </VBox>

                        <!-- Role Selection -->
                        <VBox spacing="5">
                            <Label text="I am a" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #334155;"/>
                            <ComboBox fx:id="roleComboBox" maxWidth="Infinity" styleClass="combo-input"/>
                        </VBox>

                        <!-- Feedback Labels -->
                        <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" maxWidth="440" visible="false" managed="false"/>
                        <Label fx:id="successLabel" styleClass="success-label" wrapText="true" maxWidth="440" visible="false" managed="false"/>

                        <!-- Loading Indicator -->
                        <HBox alignment="CENTER">
                            <ProgressIndicator fx:id="loadingIndicator" prefWidth="22" prefHeight="22" visible="false" managed="false"/>
                        </HBox>

                        <!-- Register Button -->
                        <Button fx:id="registerButton"
                                text="Create Account →"
                                maxWidth="Infinity"
                                styleClass="primary-button"
                                style="-fx-font-size: 14px; -fx-padding: 12 0; -fx-background-color: #0F172A;"
                                onAction="#handleRegister"/>

                    </VBox>

                    <!-- Footer Link -->
                    <HBox alignment="CENTER" spacing="6" style="-fx-padding: 8 0 0 0;">
                        <Label text="Already have an account?" style="-fx-font-size: 13px; -fx-text-fill: #64748B;"/>
                        <Hyperlink fx:id="loginLink"
                                   text="Sign in"
                                   styleClass="footer-link"
                                   style="-fx-font-size: 13px; -fx-text-fill: #2563EB;"
                                   onAction="#handleLoginLink"/>
                    </HBox>

                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>

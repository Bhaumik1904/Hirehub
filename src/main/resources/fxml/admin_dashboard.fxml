                                      visible="false" managed="false">
                                    <Label text="No Jobs Found" styleClass="admin-empty-title"/>
                                    <Label text="No job postings match the active search and moderation/lifecycle filter criteria."
                                           styleClass="admin-empty-body" wrapText="true"/>
                                </VBox>
                            </VBox>

                            <!-- Right: Detailed Job Review Panel -->
                            <VBox minWidth="340" prefWidth="380" maxWidth="420" styleClass="admin-detail-panel" spacing="12">
                                <!-- Placeholder when nothing selected -->
                                <VBox fx:id="jobModPlaceholderBox" alignment="CENTER" spacing="8" minHeight="350">
                                    <Label text="Select a Job Posting" styleClass="admin-empty-title"/>
                                    <Label text="Choose a job posting from the table on the left to inspect job specifications, requirements, and record a moderation decision."
                                           wrapText="true" styleClass="admin-empty-body" textAlignment="CENTER"/>
                                </VBox>

                                <!-- Detail Content (visible when a row is selected) -->
                                <VBox fx:id="jobModDetailContainer" spacing="10" visible="false" managed="false">
                                    <HBox styleClass="admin-detail-header" alignment="CENTER_LEFT" spacing="8">
                                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                                            <Label fx:id="jobModDetailTitle" text="Job Title" styleClass="admin-detail-title" wrapText="true"/>
                                            <Label fx:id="jobModDetailCompany" text="Company Name" styleClass="admin-detail-sub"/>
                                        </VBox>
                                        <HBox spacing="4" alignment="CENTER_RIGHT">
                                            <Label fx:id="jobModDetailLifecycleBadge" text="ACTIVE" styleClass="admin-badge"/>
                                            <Label fx:id="jobModDetailModerationBadge" text="PENDING" styleClass="admin-badge"/>
                                        </HBox>
                                    </HBox>

                                    <!-- Attributes Grid -->
                                    <VBox spacing="6" styleClass="admin-detail-grid">
                                        <HBox spacing="8" alignment="CENTER_LEFT">
                                            <Label text="Recruiter:" styleClass="admin-detail-key" minWidth="110"/>
                                            <Label fx:id="jobModDetailRecruiter" text="—" styleClass="admin-detail-val" wrapText="true"/>
                                        </HBox>
                                        <HBox spacing="8" alignment="CENTER_LEFT">
                                            <Label text="Type &amp; Loc:" styleClass="admin-detail-key" minWidth="110"/>
                                            <Label fx:id="jobModDetailTypeAndLocation" text="—" styleClass="admin-detail-val"/>
                                        </HBox>
                                        <HBox spacing="8" alignment="CENTER_LEFT">
                                            <Label text="Salary Range:" styleClass="admin-detail-key" minWidth="110"/>
                                            <Label fx:id="jobModDetailSalary" text="—" styleClass="admin-detail-val"/>
                                        </HBox>
                                        <HBox spacing="8" alignment="CENTER_LEFT">
                                            <Label text="Dates:" styleClass="admin-detail-key" minWidth="110"/>
                                            <Label fx:id="jobModDetailDates" text="—" styleClass="admin-detail-val" wrapText="true"/>
                                        </HBox>
                                        <VBox spacing="2">
                                            <Label text="Required Skills:" styleClass="admin-detail-key"/>
                                            <Label fx:id="jobModDetailSkills" text="—" wrapText="true" styleClass="admin-detail-val"/>
                                        </VBox>
                                        <VBox spacing="2">
                                            <Label text="Eligibility Criteria:" styleClass="admin-detail-key"/>
                                            <Label fx:id="jobModDetailEligibility" text="—" wrapText="true" styleClass="admin-detail-val"/>
                                        </VBox>
                                        <VBox spacing="3">
                                            <Label text="Job Description:" styleClass="admin-detail-key"/>
                                            <Label fx:id="jobModDetailDesc" text="—" wrapText="true" styleClass="admin-detail-desc"/>
                                        </VBox>
                                        <VBox spacing="3">
                                            <Label text="Moderation Feedback / Reason:" styleClass="admin-detail-key"/>
                                            <Label fx:id="jobModDetailReason" text="—" wrapText="true" styleClass="admin-detail-desc"/>
                                        </VBox>
                                        <HBox spacing="8" alignment="CENTER_LEFT">
                                            <Label text="Moderation Info:" styleClass="admin-detail-key" minWidth="110"/>
                                            <Label fx:id="jobModDetailReviewMetadata" text="—" styleClass="admin-detail-val" wrapText="true"/>
                                        </HBox>
                                    </VBox>

                                    <!-- Action Buttons Bar -->
                                    <HBox spacing="8" styleClass="admin-action-bar">
                                        <Button fx:id="btnApproveJob" text="Approve"
                                                styleClass="admin-btn-verify"
                                                onAction="#handleApproveJob"/>
                                        <Button fx:id="btnRejectJob" text="Reject"
                                                styleClass="admin-btn-reject"
                                                onAction="#handleRejectJob"/>
                                        <Button fx:id="btnSuspendJob" text="Suspend"
                                                styleClass="admin-btn-suspend"
                                                onAction="#handleSuspendJob"/>
                                        <Button fx:id="btnReturnJobPending" text="To Pending"
                                                styleClass="admin-btn-pending"
                                                onAction="#handleReturnJobPending"/>
                                    </HBox>

                                    <!-- Job Moderation Audit History -->
                                    <VBox spacing="6" styleClass="admin-audit-box">
                                        <Label text="Moderation Audit History" styleClass="detail-key"/>
                                        <VBox fx:id="jobAuditListContainer" spacing="4"/>
                                        <Label fx:id="jobAuditEmptyLabel" text="No moderation audit records found."
                                               styleClass="admin-kpi-sub" visible="false" managed="false"/>
                                    </VBox>
                                </VBox>
                            </VBox>
                        </HBox>
                    </VBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>

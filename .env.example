# HireHub Environment Configuration Example
# Copy this file to .env or configure environment variables directly in your system/shell.

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hirehub_db
DB_USER=root
DB_PASS=your_mysql_password_here

# GroqCloud AI Configuration (Required for AI Career Assistant and Resume Review)
# Obtain your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: GroqCloud Model Selection (Default: openai/gpt-oss-20b)
# GROQ_MODEL=openai/gpt-oss-20b

# Optional: GroqCloud Fallback Model (Default: llama-3.3-70b-versatile)
# GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile
